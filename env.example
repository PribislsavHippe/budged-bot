# Скопируй как .env и заполни

# Токен от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Supabase (Settings → API). Серверный service_role, не anon.
# Никогда не передавать ключ в мини-приложение.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Для деплоя на Render (локально НЕ заполняй — бот запустится в режиме polling)
# WEBHOOK_HOST=https://your-app.onrender.com

# Ссылка на исходники — показывается в /privacy, чтобы человек мог проверить
# на слово, а не поверить. Пусто — строчку про код бот не покажет.
# SOURCE_URL=https://github.com/username/budget-bot

# Твой числовой Telegram id — открывает /admin (сводка) и /broadcast (рассылка).
# Узнать свой id: напиши боту /privacy, он его показывает.
# Пусто — админские команды не работают ни у кого.
# ADMIN_ID=123456789

# Куда писать за доступом к Google Календарю. Показывается в мини-апе.
# SUPPORT_CONTACT=@username

# Приложение прошло проверку Google и доступно всем? Тогда поставь 0,
# и мини-ап перестанет предупреждать про ручное подключение.
# GOOGLE_INVITE_ONLY=1

# Час по МСК, с которого начинается новый рабочий день. Ночная смена целиком
# относится к дню, в который началась. По умолчанию 6.
# DAY_START_HOUR=6

# Необязательно: секрет webhook. По умолчанию безопасно выводится из BOT_TOKEN.
# WEBHOOK_SECRET=your_random_secret

# Пробное распознавание фото отчётов. Ключ — только на сервере.
# GROQ_API_KEY=your_groq_api_key
# REPORT_VISION_ENABLED=1
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
