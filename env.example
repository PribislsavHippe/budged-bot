# =============================================
# Скопируй этот файл как .env и заполни значения
# =============================================

# Telegram Bot Token (получи у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Supabase (Settings → API в твоём проекте)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Google Calendar API
# Создай проект на console.cloud.google.com
# Включи Google Calendar API
# Создай OAuth 2.0 credentials (тип: Web application)
# Redirect URI: https://твой-домен.onrender.com/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-app.onrender.com/google/callback

# URL твоего приложения на Render
WEBHOOK_HOST=https://your-app.onrender.com
WEBHOOK_PATH=/webhook
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
