# Скопируй как .env и заполни

# Токен от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Supabase (Settings → API). Серверный service_role, не anon.
# Никогда не передавать ключ в мини-приложение.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Для деплоя на Render (локально НЕ заполняй — бот запустится в режиме polling)
# WEBHOOK_HOST=https://your-app.onrender.com

# Ссылка на исходники — показывается в /privacy, чтобы человек мог проверить
# на слово, а не поверить. Пусто — строчку про код бот не покажет.
# SOURCE_URL=https://github.com/username/repository

# Твой числовой Telegram id — открывает /admin (сводка) и /broadcast (рассылка).
# Узнать свой id: напиши боту /privacy, он его показывает.
# Пусто — админские команды не работают ни у кого.
# ADMIN_ID=123456789

# Необязательно: Telegram ID одного получателя обращения «приятель» в личном чате.
# FRIEND_TELEGRAM_ID=

# Календарь подключается подпиской по ссылке; ключи Google OAuth не нужны.

# Таблица записи на тренинги (ссылка или её ID). Одна на все месяцы: бот читает все листы.
# Не храни её в репозитории — в таблице имена сотрудников.
# TRAINING_SHEET=https://docs.google.com/spreadsheets/d/.../edit

# Подсказки по меню (состав, аллергены, фото): admin — только владелец бота (по умолчанию), staff — ещё
# подтверждённые сотрудники ресторанов. Меню загружается так: владелец присылает боту PDF из «Подсказок».
# MENU_ACCESS=admin
# Разбирать PDF меню, присланный в чат, прямо на сервере: 1 — да. На бесплатном Render не хватает памяти,
# поэтому по умолчанию выключено, а меню загружается с компьютера: .venv/bin/python menu_import.py файл.pdf
# MENU_PDF_UPLOAD=

# Календарь выходных в виде виджета Telegram: 1 — всем, admin — только ADMIN_ID. Пусто — обычное сообщение.
# DAYS_OFF_WIDGETS=
# Тот же календарь выходных в мини-приложении (/app/days-off), пока Telegram не пускает ботов к виджетам:
# admin — ссылку в календаре видит только ADMIN_ID (по умолчанию), 1 — все сотрудники, 0 — никто.
# DAYS_OFF_MINIAPP=admin

# Час по МСК, с которого начинается новый рабочий день. Ночная смена целиком
# относится к дню, в который началась. По умолчанию 6.
# DAY_START_HOUR=6

# Необязательно: секрет webhook. По умолчанию безопасно выводится из BOT_TOKEN.
# WEBHOOK_SECRET=your_random_secret

# Необязательно: постоянный секрет шифрования очереди входящих сообщений.
# Сохрани его при смене BOT_TOKEN, чтобы обработать оставшиеся сообщения.
# Без него очередь шифруется ключом, выведенным из BOT_TOKEN.
# INBOX_ENCRYPTION_KEY=your_separate_random_secret
# Число воркеров очереди входящих (по умолчанию 16: фото в очереди распознавания занимает воркер).
# INBOX_WORKERS=16

# Пробное распознавание фото отчётов. Ключ — только на сервере.
# GROQ_API_KEY=your_groq_api_key
# REPORT_VISION_ENABLED=1
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Идентификация сотрудников: включать только после migration_v9.sql.
# Первый администратор — пользователь из ADMIN_ID.
# IDENTITY_ENABLED=1

# Пробный построчный разбор стандартного скриншота; сохраняет существующий план.
# REPORT_ROW_MODE=1
